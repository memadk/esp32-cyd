{
 "uid": "esp32-board",
 "title": "ESP32 board",
 "tags": [
  "esp32",
  "board"
 ],
 "timezone": "browser",
 "editable": true,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "board",
    "label": "Board",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "refresh": 2,
    "sort": 1,
    "query": {
     "label": "board",
     "refId": "LokiVariableQueryEditor-VariableQuery",
     "stream": "",
     "type": 1
    },
    "definition": "label_values(board)",
    "current": {},
    "options": []
   },
   {
    "name": "tag",
    "label": "Tag",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "refresh": 2,
    "sort": 1,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "query": {
     "label": "tag",
     "refId": "LokiVariableQueryEditor-VariableQuery",
     "stream": "{board=\"$board\"}",
     "type": 1
    },
    "definition": "label_values({board=\"$board\"}, tag)",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "options": []
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "name": "Boot",
    "enable": true,
    "iconColor": "red",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "expr": "{board=\"$board\"} |= \"BOOT \"",
    "titleFormat": "Boot",
    "textFormat": "{{board}}"
   }
  ]
 },
 "panels": [
  {
   "type": "stat",
   "title": "Heap free",
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "max by (board) (max_over_time({board=\"$board\"} |~ \"heap (?P<heap>\\\\d+) free\" | regexp \"heap (?P<heap>\\\\d+) free\" | unwrap heap [$__auto]))",
     "legendFormat": "",
     "refId": "A",
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
