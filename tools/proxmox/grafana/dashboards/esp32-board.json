  {
   "type": "timeseries",
   "title": "Heap",
   "description": "From the minute status line. Restart threshold (heap watchdog) is 18 KB.",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
