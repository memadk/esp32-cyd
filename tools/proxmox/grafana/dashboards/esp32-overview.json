{
 "uid": "esp32-overview",
 "title": "ESP32 overview",
 "tags": [
  "esp32",
  "overview"
 ],
 "timezone": "browser",
 "editable": true,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "templating": {
  "list": []
 },
 "annotations": {
  "list": [
   {
    "name": "Boot",
    "enable": true,
    "iconColor": "red",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "expr": "{board=~\".+\"} |= \"BOOT \"",
    "titleFormat": "Boot",
    "textFormat": "{{board}}"
   }
  ]
 },
 "panels": [
  {
   "type": "timeseries",
   "title": "Heap free, all boards",
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "max by (board) (max_over_time({board=~\".+\"} |~ \"heap (?P<heap>\\\\d+) free\" | regexp \"heap (?P<heap>\\\\d+) free\" | unwrap heap [$__auto]))",
     "legendFormat": "{{board}}",
     "refId": "A",
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": 300000
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Wi-Fi RSSI, all boards",
   "description": "",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "max by (board) (max_over_time({board=~\".+\"} |~ \"rssi (?P<rssi>-?\\\\d+)\" | regexp \"rssi (?P<rssi>-?\\\\d+)\" | unwrap rssi [$__auto]))",
     "legendFormat": "{{board}}",
     "refId": "A",
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "dBm",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": 300000
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Warnings + errors per board",
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (board) (count_over_time({board=~\".+\", level=~\"warn|error\"} [$__auto]))",
     "legendFormat": "{{board}}",
     "refId": "A",
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": 300000
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Log lines per board",
